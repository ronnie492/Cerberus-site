{
  "name": "cerebus-site-poc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "doctor": "node scripts/doctor.mjs",
    "deploy": "node scripts/deploy.mjs",
    "deploy:db": "supabase db push",
    "deploy:functions": "supabase functions deploy",
    "deploy:web": "git push",
    "deploy:web:cli": "vercel --prod",
    "db:diff": "supabase db pull",
    "db:status": "supabase db push --dry-run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "supabase": "^2.117.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
