# Copy this file to `.env.local` and fill in the two values from your Supabase
# project (Supabase dashboard -> Project Settings -> API).
#
# `.env.local` is git-ignored on purpose. Never commit real keys.
# These same two variables must also be added in the Vercel dashboard
# (Project -> Settings -> Environment Variables) for the deployed site.
#
# Only the ANON key belongs here. The service-role key must never be given a
# VITE_ prefix, because every VITE_ variable is compiled into the public
# JavaScript bundle that anyone can read.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
